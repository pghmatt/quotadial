{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaDial",
  "version": "0.1.0",
  "identifier": "com.quotadial.desktop",
  "build": {
    "beforeDevCommand": "npm run cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run cli -- --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaDial",
        "width": 360,
        "height": 420,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/quotadial"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Claude and ChatGPT/Codex usage limits in your menu bar or tray.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "longDescription": "QuotaDial shows how much of your Claude and ChatGPT/Codex plan limits you have used, and when they reset, so a long agent run does not stop halfway. It runs the QuotaDial daemon and carries the quotadial command."
  }
}
