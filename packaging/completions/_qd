;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_qd__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qd-help-command-$line[1]:"
        case $line[1] in
