(( $+functions[_qd_commands] )) ||
_qd_commands() {
    local commands; commands=(
'status:Show current usage for every account this machine is signed in to' \
'watch:Keep showing usage, refreshing every minute. No provider is asked more often than its own limit, so most refreshes show cached numbers with their age' \
'daemon:Run the daemon until Ctrl-C\: the one poller every consumer shares, with history and the local API. While it runs, \`status\` and \`watch\` ask it instead of polling' \
'mcp:Run the MCP server named quotadial on standard input and output, for agents such as Claude Code and Codex. Like \`status\`, it asks the daemon while one runs' \
'alerts:List the alert rules and what they told lately, or add, remove, or turn one on or off. Rules are written in plain words, such as \`quotadial alerts add "warn me at 80%"\`' \
'doctor:Print what support asks for, with nothing secret in it\: the version, the system, the licence, the daemon, every account and where its sign-in is, the problems and the settings. The app'\''s Send feedback attaches the same' \
'licence:Say whether this copy is QuotaDial Free or QuotaDial Pro, or add or remove its licence key. A key is checked on this machine, with no network call' \
'history:Show how each window was used over time, from the daemon'\''s history' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'qd commands' commands "$@"
}
(( $+functions[_qd__subcmd__alerts_commands] )) ||
_qd__subcmd__alerts_commands() {
    local commands; commands=(
'list:List the rules and what they told in the last week. The default' \
'add:Add a rule written in plain words, such as "warn me at 80%", "warn me when the weekly window will run out before it resets" or "tell me 30 minutes before the session resets if it is above 50%"' \
'remove:Remove the rule with this number' \
'on:Turn the rule with this number on' \
'off:Turn the rule with this number off' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'qd alerts commands' commands "$@"
}
